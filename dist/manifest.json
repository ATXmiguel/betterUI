{
  "manifest_version": 3,
  "name": "betterUI para SIGAA (não-oficial)",
  "version": "0.1.0",
  "description": "Reorganiza a interface do SIGAA. Extensão não-oficial, sem vínculo com o CEFET-MG.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-B5N98bL8.js"
      ],
      "matches": [
        "https://sig.cefetmg.br/sigaa/*"
      ],
      "run_at": "document_idle",
      "css": [
        "assets/index-DOHXXsQF.css"
      ]
    }
  ],
  "action": {
    "default_title": "betterUI para SIGAA (não-oficial)"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://sig.cefetmg.br/*"
      ],
      "resources": [
        "assets/index.ts-B5N98bL8.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
